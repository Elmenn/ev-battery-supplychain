# Frontend Environment Variables for the ERC-7984 Sepolia spike
# Copy this file to .env for the Docker/local demo path.
# These addresses match the latest verified ERC-7984 Sepolia deployment.

# --- Network ---
REACT_APP_RPC_URL=https://ethereum-sepolia.publicnode.com
REACT_APP_CHAIN_ALIAS=11155111
REACT_APP_CHAIN_ID=11155111
REACT_APP_RAILGUN_CHAIN=ethereum
REACT_APP_RAILGUN_NETWORK=Ethereum_Sepolia
REACT_APP_RAILGUN_SCAN_RPC_URL=https://ethereum-sepolia.publicnode.com

# --- Backend API ---
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_VC_BACKEND_URL=http://localhost:5000
REACT_APP_RAILGUN_API_URL=http://localhost:3001

# --- Contracts ---
REACT_APP_FACTORY_ADDRESS=0x595c596F9fde72DD41ECB4b729c05f79867fAB4C
REACT_APP_WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
REACT_APP_ERC7984_FACTORY_ADDRESS=0x595c596F9fde72DD41ECB4b729c05f79867fAB4C
REACT_APP_ERC7984_PUBLIC_TOKEN=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
REACT_APP_ERC7984_PUBLIC_TOKEN_SYMBOL=WETH
REACT_APP_ERC7984_PUBLIC_TOKEN_IS_WRAPPED_NATIVE=true
REACT_APP_ERC7984_FUNDING_WRAPPER=0xA87435D1a6a764B555c4F941d8E2b5688Ced2c52
REACT_APP_ERC7984_CONFIDENTIAL_TOKEN=0x7CB22914e17CfdcfDE9F84D4df5A4A47233D46e9

# --- Pinata IPFS (get from https://www.pinata.cloud/) ---
REACT_APP_PINATA_JWT=your-pinata-jwt-token-here

# --- ZKP Backend ---
REACT_APP_ZKP_BACKEND_URL=http://localhost:5010
REACT_APP_ZKP_MODE=wasm

# --- Misc ---
SKIP_PREFLIGHT_CHECK=true
GENERATE_SOURCEMAP=false
REACT_APP_SUPPRESS_WARNINGS=true
REACT_APP_VERBOSE=false
REACT_APP_LOGS_CHUNK_BLOCKS=8

# Feature flags
REACT_APP_RAILGUN_WALLET_MODE=false
REACT_APP_SHIELD_STRATEGY=sdk
